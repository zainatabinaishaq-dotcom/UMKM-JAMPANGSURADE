{
  "appId": "com.umkmjampangsurade.marketplace",
  "appName": "UMKM Digital",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#EE4D2D",
      "showSpinner": false
    }
  }
}
